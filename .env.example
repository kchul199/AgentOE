# ─────────────────────────────────────────────────────────────────────────────
#  AgentOE — 환경변수 예시 파일
#  사용법: cp .env.example .env  후 실제 값으로 수정
#  ⚠️  .env 파일은 절대 Git에 커밋하지 마세요 (gitignore에 포함됨)
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
# CORS_ORIGINS=["http://localhost:3000","https://your-frontend.com"]

# ── MongoDB Replica Set ───────────────────────────────────────────────────────
# 로컬 Docker Compose 기본값 (개발용)
MONGO_ROOT_PASSWORD=agentoe_dev_pass
MONGODB_URI=mongodb://admin:agentoe_dev_pass@localhost:27017,localhost:27018/?replicaSet=rs0&authSource=admin
MONGODB_DB_NAME=agentoe

# 프로덕션 예시 (Atlas)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=agentoe_prod

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# 프로덕션 (TLS + 인증)
# REDIS_URL=rediss://:password@your-redis-host:6380/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# ⚠️  운영 환경에서는 반드시 64자 이상의 랜덤 문자열로 교체할 것
# 생성: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_use_secrets.token_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Groq AI (STT + LLM) ───────────────────────────────────────────────────────
# https://console.groq.com → API Keys
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-4-scout-17b-16e-instruct
GROQ_LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# ── Google Cloud TTS ──────────────────────────────────────────────────────────
# 서비스 계정 JSON 파일 경로 (Docker 볼륨 마운트 필요)
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-tts.json
GOOGLE_TTS_LANGUAGE=ko-KR
GOOGLE_TTS_VOICE=ko-KR-Neural2-C

# ── VBGW (Voice Bot Gateway) ─────────────────────────────────────────────────
VBGW_GRPC_ENDPOINT=grpc://localhost:50051
VBGW_WS_ENDPOINT=ws://localhost:50052

# ── Circuit Breaker ───────────────────────────────────────────────────────────
CB_FAILURE_THRESHOLD=5           # OPEN 전환 연속 실패 횟수
CB_RECOVERY_TIMEOUT=30           # OPEN → HALF_OPEN 대기 시간(초)
CB_HALF_OPEN_MAX_CALLS=3         # HALF_OPEN 상태 최대 탐침 호출 수

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=86400        # 세션 Redis TTL (기본 24시간)
MAX_SESSIONS_PER_TENANT=100      # 테넌트당 동시 활성 세션 한도 (Admission Control)
