# ──────────────────────────────────────────
# AgentOE Backend Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to git
# ──────────────────────────────────────────

# Application
ENVIRONMENT=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=["http://localhost:3000"]

# MongoDB (Replica Set)
MONGODB_URI=mongodb://admin:yourpassword@localhost:27017,localhost:27018/?replicaSet=rs0&authSource=admin
MONGODB_DB_NAME=agentoe

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=your_64_character_random_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Groq AI
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-4-scout-17b-16e-instruct

# Google TTS
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-tts.json
GOOGLE_TTS_LANGUAGE=ko-KR
GOOGLE_TTS_VOICE=ko-KR-Neural2-C

# VBGW
VBGW_GRPC_ENDPOINT=grpc://localhost:50051
VBGW_WS_ENDPOINT=ws://localhost:50052

# Session
SESSION_TTL_SECONDS=86400
MAX_SESSIONS_PER_TENANT=100

# Circuit Breaker
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=30
