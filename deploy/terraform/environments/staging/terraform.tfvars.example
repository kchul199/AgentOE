# ──────────────────────────────────────────────────────────────────────────
# Staging 환경 입력 예시. 실제 값은 환경마다 만든 terraform.tfvars (gitignore!)
# 또는 -var-file=secrets.staging.tfvars 로 주입.
# Atlas API 키는 환경변수 MONGODB_ATLAS_PUBLIC_KEY/PRIVATE_KEY 로.
# ──────────────────────────────────────────────────────────────────────────

project     = "agentoe"
environment = "staging"
region      = "ap-northeast-2"

# 네트워크
vpc_cidr = "10.50.0.0/16"
azs      = ["ap-northeast-2a", "ap-northeast-2b", "ap-northeast-2c"]

# EKS
eks_version             = "1.29"
eks_node_instance_types = ["c7g.large"]
eks_node_desired_size   = 2
eks_node_min_size       = 2
eks_node_max_size       = 6

# Redis
redis_node_type          = "cache.t4g.small"
redis_num_cache_clusters = 2

# MongoDB Atlas
atlas_org_id        = "REPLACE_WITH_REAL_ORG_ID"
atlas_instance_size = "M10"

# Admin / VPN 출구 IP — kubectl/Atlas UI 접근 허용 CIDR.
# 반드시 회사 VPN 또는 bastion 의 EIP /32 만 넣을 것.
admin_cidrs = [
  # "203.0.113.10/32",   # Office VPN
  # "203.0.113.20/32",   # Bastion
]

# DNS — 빈 문자열이면 ACM/Route53 단계 스킵.
domain_name = "" # "agentoe.io"
