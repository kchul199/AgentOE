{
  "uid": "vbgw",
  "title": "AgentOE — VBGW (Voice Bridge)",
  "tags": ["agentoe", "vbgw", "voice"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": { "list": [{ "name": "datasource", "type": "datasource", "query": "prometheus",
    "current": { "text": "Prometheus", "value": "Prometheus" } }] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Call setup ratio (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "${datasource}",
      "targets": [{ "expr": "slo:vbgw_call_setup_ratio:rate1h", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 4,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "orange", "value": 0.998 }, { "color": "green", "value": 0.999 }
        ]}}}
    },
    {
      "id": 2, "type": "stat", "title": "Mid-call drop ratio (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": "${datasource}",
      "targets": [{ "expr": "slo:vbgw_mid_call_drop_ratio:rate1h", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 4,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 0.001 }, { "color": "red", "value": 0.005 }
        ]}}}
    },
    {
      "id": 3, "type": "stat", "title": "Active calls",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": "${datasource}",
      "targets": [{ "expr": "sum(agentoe_active_calls)", "refId": "A" }]
    },
    {
      "id": 4, "type": "stat", "title": "Calls / min (5m avg)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": "${datasource}",
      "targets": [{ "expr": "60 * sum(rate(agentoe_call_setup_total{result=\"ok\"}[5m]))", "refId": "A" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "Setup result breakdown",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "${datasource}",
      "targets": [{ "expr": "sum by (result) (rate(agentoe_call_setup_total[5m]))", "legendFormat": "{{result}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Termination reasons",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": "${datasource}",
      "targets": [{ "expr": "sum by (reason) (rate(agentoe_call_terminations_total[5m]))", "legendFormat": "{{reason}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 20, "type": "timeseries", "title": "Call duration p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "histogram_quantile(0.5,  sum by (le) (rate(agentoe_call_duration_seconds_bucket[15m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(agentoe_call_duration_seconds_bucket[15m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(agentoe_call_duration_seconds_bucket[15m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 21, "type": "timeseries", "title": "Pod-level active calls (saturation)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": "${datasource}",
      "targets": [{ "expr": "agentoe_active_calls", "legendFormat": "{{pod}}", "refId": "A" }]
    },
    {
      "id": 30, "type": "timeseries", "title": "vbgw HPA — replicas vs desired",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "kube_horizontalpodautoscaler_status_current_replicas{horizontalpodautoscaler=\"agentoe-vbgw\"}", "legendFormat": "current", "refId": "A" },
        { "expr": "kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"agentoe-vbgw\"}", "legendFormat": "desired", "refId": "B" },
        { "expr": "kube_horizontalpodautoscaler_spec_max_replicas{horizontalpodautoscaler=\"agentoe-vbgw\"}", "legendFormat": "max", "refId": "C" }
      ]
    }
  ]
}
