# ops-portal 환경 변수 (Vite — VITE_ 접두사만 클라이언트에 노출됨)

# 시나리오 저작 도구(별도 frontend 서비스) URL.
# 미설정 시 로컬 dev 포트(http://localhost:5173)로 폴백.
# 예) staging: https://builder.staging.agentoe.example.com
#     prod:    https://builder.agentoe.example.com
VITE_SCENARIO_BUILDER_URL=

# 로컬 개발 시 backend proxy target (기본값 http://localhost:8000)
VITE_API_TARGET=http://localhost:8000
