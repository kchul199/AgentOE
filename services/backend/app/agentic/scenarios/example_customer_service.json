{
  "scenario_id": "cs_account_v3",
  "tenant_id": "t_acme",
  "version": 3,
  "name": "고객센터 계정 문의 (Sample)",
  "description": "인사 → 인텐트 분류 → (잔액조회 | 결제 문의 | 상담원 전환) 분기",
  "entry": "greeting",
  "fallback_node": "fallback_speak",
  "tags": ["customer_service", "ko-KR", "sample"],
  "published": true,
  "limits": {
    "max_turns": 20,
    "max_duration_s": 600,
    "max_tool_calls_per_turn": 2,
    "max_cost_cents_per_session": 30.0
  },
  "nodes": [
    {
      "id": "greeting",
      "type": "llm",
      "label": "인사말",
      "config": {
        "model": "groq-llama-4-scout",
        "fallback_model": "groq-llama-3.3-70b",
        "system_prompt": "당신은 ACME 고객센터의 친절한 AI 상담원입니다. 한국어로 1-2문장 이내로 인사하세요.",
        "prompt_template": "안녕하세요. 무엇을 도와드릴까요?",
        "temperature": 0.5,
        "max_tokens": 128,
        "streaming": true,
        "enable_filler": true
      }
    },
    {
      "id": "wait_user",
      "type": "wait",
      "label": "사용자 응답 대기",
      "config": {"timeout_s": 15, "prompt_on_timeout": "죄송합니다, 다시 말씀해 주세요."}
    },
    {
      "id": "classify",
      "type": "intent",
      "label": "인텐트 분류",
      "config": {
        "labels": ["balance_inquiry", "billing", "agent_transfer", "end_call", "unknown"],
        "model": "groq-llama-3.3-70b",
        "threshold": 0.6
      }
    },
    {
      "id": "router",
      "type": "branch",
      "label": "인텐트 라우팅",
      "config": {"mode": "intent"}
    },
    {
      "id": "lookup_balance",
      "type": "tool",
      "label": "잔액 조회",
      "config": {
        "tool_name": "account.get_balance",
        "args_template": {"account_id": "{slot.account_id}"},
        "timeout_s": 3.0,
        "retry": 1,
        "on_error": "fallback"
      }
    },
    {
      "id": "respond_balance",
      "type": "llm",
      "label": "잔액 안내",
      "config": {
        "model": "groq-llama-3.3-70b",
        "fallback_model": "groq-llama-3.3-70b",
        "system_prompt": "잔액 정보를 간결하고 정중하게 안내하세요. 개인정보는 포함하지 마세요.",
        "prompt_template": "고객님의 현재 잔액은 {slot.tool_result}원입니다.",
        "max_tokens": 128
      }
    },
    {
      "id": "respond_billing",
      "type": "llm",
      "label": "결제 문의 응답",
      "config": {
        "model": "groq-llama-4-scout",
        "fallback_model": "groq-llama-3.3-70b",
        "system_prompt": "결제 관련 문의에 답합니다. 확실치 않은 금액/날짜는 추정하지 말고 확인 필요 안내.",
        "max_tokens": 256
      }
    },
    {
      "id": "agent_transfer",
      "type": "transfer",
      "label": "상담원 전환",
      "config": {"queue": "cs_general", "reason": "user_request", "include_summary": true}
    },
    {
      "id": "fallback_speak",
      "type": "llm",
      "label": "폴백 안내",
      "config": {
        "model": "groq-llama-3.3-70b",
        "fallback_model": "groq-llama-3.3-70b",
        "system_prompt": "시스템 문제로 안내가 어렵다는 취지를 정중히 전하고, 상담원 연결을 제안하세요.",
        "max_tokens": 120
      }
    },
    {
      "id": "end",
      "type": "end",
      "label": "정상 종료",
      "config": {"closing_message": "문의 주셔서 감사합니다. 좋은 하루 되세요."}
    }
  ],
  "edges": [
    {"from": "greeting", "to": "wait_user"},
    {"from": "wait_user", "to": "classify"},
    {"from": "classify", "to": "router"},
    {"from": "router", "when": "balance_inquiry", "to": "lookup_balance", "label": "잔액 조회"},
    {"from": "router", "when": "billing", "to": "respond_billing", "label": "결제 문의"},
    {"from": "router", "when": "agent_transfer", "to": "agent_transfer", "label": "상담원 요청"},
    {"from": "router", "when": "end_call", "to": "end", "label": "종료"},
    {"from": "router", "when": "default", "to": "fallback_speak", "label": "기타"},
    {"from": "lookup_balance", "to": "respond_balance"},
    {"from": "respond_balance", "to": "wait_user"},
    {"from": "respond_billing", "to": "wait_user"},
    {"from": "fallback_speak", "to": "agent_transfer"}
  ]
}
