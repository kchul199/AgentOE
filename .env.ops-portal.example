# ─────────────────────────────────────────────────────────────────────────────
# agentoe-portal 로컬 개발용 환경변수 예시
# 사용: cp .env.ops-portal.example .env.ops-portal
#       source .env.ops-portal  또는  direnv allow
#
# docker/compose.ops-portal.dev.yml 은 이 파일 없이도 기본값으로 동작합니다.
# 커스텀 값이 필요한 경우에만 이 파일을 사용하세요.
# ─────────────────────────────────────────────────────────────────────────────

# ── 인프라 ────────────────────────────────────────────────────────────────────
MONGO_ROOT_PASSWORD=agentoe_dev_pass
MONGODB_URI=mongodb://admin:agentoe_dev_pass@localhost:27017/agentoe?authSource=admin
MONGODB_DB_NAME=agentoe
REDIS_URL=redis://localhost:6380/0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-local-only
PORTAL_JWT_SECRET=dev-portal-jwt-secret-local

# ── Portal 인증 ───────────────────────────────────────────────────────────────
PORTAL_ORIGIN=http://localhost:5174
PORTAL_JWT_EXPIRE_MINUTES=30
PORTAL_REFRESH_EXPIRE_HOURS=24

# MFA envelope key — 반드시 64자 hex (32 bytes).
# 아래는 로컬 전용 샘플. 운영 환경에 절대 사용하지 말 것.
PORTAL_MFA_ENVELOPE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AWS KMS — 로컬 dev 에서는 비워두면 PORTAL_MFA_ENVELOPE_KEY fallback.
# 운영에서는 KMS ARN 으로 설정.
PORTAL_KMS_KEY_ID=
PORTAL_KMS_REGION=ap-northeast-2

# ── 외부 연동 (없으면 빈 응답 반환) ──────────────────────────────────────────
ALERTMANAGER_URL=http://localhost:9093
PROMETHEUS_URL=http://localhost:9090

# ── 기타 ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=dummy-groq-key-for-dev
ENVIRONMENT=development
LOG_LEVEL=info
SSE_MAX_CONNECTIONS_PER_POD=0

# ── seed_portal_admin.py 기본값 ───────────────────────────────────────────────
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=admin123
