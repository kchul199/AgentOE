# ──────────────────────────────────────────────────────────────────────────
# Root .gitignore — agentoe monorepo
# 서비스별 패턴은 services/<svc>/.gitignore 로 분리 가능.
# ──────────────────────────────────────────────────────────────────────────

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Office app lock files (xlsx/docx 열려 있을 때 생성)
.~lock.*#
~$*

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node / TypeScript
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Go
*.test
*.out
vendor/

# Docker / build
*.pid
.cache/

# Secrets / local config
*.env
*.env.local
!*.env.example
.envrc
credentials/google-tts.json
credentials/*.pem
credentials/*.key

# Test outputs
test-results/
playwright-report/
htmlcov/
coverage-*.xml
trivy-*.sarif

# Frontend build caches
.next/
.turbo/

# Backup / temp
*.bak
*.orig
*.rej
